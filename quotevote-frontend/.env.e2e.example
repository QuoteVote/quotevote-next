# Playwright E2E
# Copy to .env.e2e.local and fill in credentials before running tests.
#
# --- Run commands (from quotevote-frontend/) ---
# All E2E:              pnpm test:e2e
# One spec file:        pnpm test:e2e post-submission.spec.ts
# By test sheet ID:     pnpm test:e2e --grep "E2E-POST-001"
# Exclude a case:       pnpm test:e2e --grep-invert "E2E-POST-001"
# Desktop only:         pnpm test:e2e --project=desktop post-submission.spec.ts
# Mobile only:          pnpm test:e2e --project=mobile post-submission.spec.ts
# Headed (see browser): pnpm test:e2e:headed post-submission.spec.ts
# Debug UI:             pnpm test:e2e:ui
# Dev server already up: PLAYWRIGHT_SKIP_WEBSERVER=1 pnpm test:e2e post-submission.spec.ts
#
# Sheet columns covered:
#   Test ID:        E2E-POST-001
#   Data Needed:    authorUser
#   Spec File:      post-submission.spec.ts
#   Viewports:      Desktop, Mobile (playwright.config.ts projects: desktop, mobile)

# Registered author account (Actor: Registered User, Auth: Logged in)
E2E_AUTHOR_USERNAME=authorUser
E2E_AUTHOR_PASSWORD=

# Optional second account for E2E-CHAT-008 @person search (must differ from author).
# When unset, the @person step is skipped; keyword/#tag coverage still runs.
# E2E_PEER_USERNAME=peerUser

# Optional admin account for the invite review specs (E2E-AUTH-010).
# When unset, those specs are skipped.
# E2E_ADMIN_USERNAME=adminUser
# E2E_ADMIN_PASSWORD=

# Tag title to select in composer (must exist on API; use a public-privacy tag e.g. QA)
E2E_PUBLIC_TAG_NAME=QA
# Legacy alias (still read by e2e/helpers/post-composer.ts if E2E_PUBLIC_TAG_NAME is unset):
# E2E_PUBLIC_GROUP_NAME=QA

# Frontend URL under test (Playwright baseURL)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Optional API overrides (defaults to NEXT_PUBLIC_* from .env.local)
# Email E2E (#498) REQUIRES an explicit non-prod API — never api.quote.vote:
# E2E_API_URL=http://localhost:4000
# E2E_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
#
# --- Running against the new backend (quotevote-backend) ---
# 1. Start quotevote-backend against a test database (pnpm dev, port 4000).
# 2. Start the frontend against it, with the backend's JWT_SECRET so the proxy
#    accepts its sessions:
#      NEXT_PUBLIC_SERVER_URL=http://localhost:4000 \
#      NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql \
#      JWT_SECRET=<backend JWT_SECRET> pnpm dev
# 3. Point the specs at the same API and run them:
#      E2E_API_URL=http://localhost:4000 PLAYWRIGHT_SKIP_WEBSERVER=1 pnpm test:e2e
# The author, admin and peer accounts must already exist in that database.

# The author must already exist: /auth/register does not create accounts.
# On a local backend, seed it from quotevote-backend/ with the same credentials:
#   E2E_AUTHOR_PASSWORD=... DATABASE_URL=... pnpm seed:e2e-author

# --- #498 transactional email delivery (email-delivery.spec.ts) ---
# 1. In quotevote-backend: dummy SendGrid + mock redirect
#      SENDGRID_API_KEY=SG.e2e-mock
#      SENDGRID_SENDER_EMAIL=noreply@quotevote.local
#      SENDGRID_MOCK_BASE_URL=http://127.0.0.1:4010
# 2. Start the mock: cd quotevote-backend && pnpm sendgrid:mock
# 3. Point Playwright at the same mock:
# E2E_SENDGRID_MOCK_URL=http://127.0.0.1:4010
#
# Existing local account email for E2E-EMAIL-001 (password reset):
# E2E_EMAIL_RECIPIENT=you@example.com
#
# Admin who can approve/resend invites (003/004):
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=
