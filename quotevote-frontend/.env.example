# Quote.Vote API — local development
# Copy to `.env.local` and adjust for your machine. Never commit `.env.local`.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Optional: point at hosted staging/production instead of local backend
# NEXT_PUBLIC_SERVER_URL=https://api.quote.vote
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=https://api.quote.vote/graphql

# WebSocket is auto-derived by getGraphqlWsServerUrl():
#   ws://localhost:4000/graphql   (local)
#   wss://api.quote.vote/graphql  (hosted)
# Optional: same secret as the API (`JWT_SECRET`) so edge middleware can
# cryptographically verify `qv-token` cookies. Never use NEXT_PUBLIC_ for this.
# JWT_SECRET=your-local-dev-secret-change-me

# Solid Pod connection UI (Settings card and /settings/solid/callback).
# Keep "false" unless the API you point at implements the solid* operations.
# Must be "true" for the Client ID Document at /solid/client-id.json to be served.
NEXT_PUBLIC_SOLID_ENABLED=false
# Pod provider pre-filled on the Settings connect form.
NEXT_PUBLIC_SOLID_DEFAULT_ISSUER=https://solidcommunity.net

# Public origin used for the Solid Client ID Document (defaults to the request origin)
# NEXT_PUBLIC_APP_URL=https://example.com
