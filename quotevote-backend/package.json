{
  "name": "quotevote-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "build": "tsc",
    "start": "node dist/app/start.js",
    "test": "jest --passWithNoTests",
    "test:prisma": "tsx scripts/check-replica-set.ts && jest --testPathPattern='prisma-.*\\.test\\.ts$' --testPathIgnorePatterns='[]'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "check:contract": "tsx scripts/check-frontend-contract.ts",
    "prisma:generate": "prisma generate --schema=./prisma/schema",
    "prisma:validate": "prisma validate --schema=./prisma/schema",
    "prisma:format": "prisma format --schema=./prisma/schema",
    "prisma:push": "prisma db push --schema=./prisma/schema",
    "prisma:studio": "prisma studio --schema=./prisma/schema",
    "prisma:sync": "pnpm prisma:push && pnpm prisma:generate",
    "prisma:health": "tsx scripts/prisma-health-check.ts",
    "prisma:test": "tsx scripts/check-replica-set.ts && tsx scripts/prisma-crud-test.ts",
    "prisma:parity": "tsx scripts/check-replica-set.ts && tsx scripts/prisma-mongoose-parity.ts",
    "roster:audit": "tsx scripts/roster-audit.ts",
    "roster:backfill": "tsx scripts/roster-backfill.ts",
    "roster:seed-fixtures": "tsx scripts/seed-roster-fixtures.ts",
    "seed:e2e-author": "tsx scripts/seed-e2e-author.ts",
    "seed:e2e-user": "tsx scripts/seed-e2e-user.ts",
    "botreport:repair": "tsx scripts/repair-bot-reports.ts",
    "sendgrid:mock": "tsx scripts/sendgrid-mock-server.ts",
    "postinstall": "prisma generate --schema=./prisma/schema"
  },
  "prisma": {
    "schema": "./prisma/schema"
  },
  "_legacy_scripts_TODO_remove_after_stable": {
    "dev": "babel-node src/index.js",
    "build": "babel src -d dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^10.1.5",
    "@prisma/client": "^6.19.3",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "11.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
